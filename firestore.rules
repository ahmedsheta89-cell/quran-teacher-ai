rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /users/{userId}
// Document ID: Firebase Auth UID (`userId`, string <= 128 chars)
// Fields:
//   - uid: string (required, <= 128 chars, matches document ID)
//   - email: string (required, <= 200 chars)
//   - displayName: string (optional, <= 100 chars)
//   - photoURL: string (optional, <= 1000 chars)
//   - role: string (optional, enum: 'ADMIN', 'TEACHER', 'STUDENT')
//   - createdAt: string (optional, ISO timestamp <= 64 chars)
//   - updatedAt: string (optional, ISO timestamp <= 64 chars)
//
// Subcollection: /users/{userId}/profiles/{profileId}
// Document ID: Deterministic Student ID (`profileId`, string <= 128 chars)
// Fields:
//   - studentId: string (required, <= 128 chars, matches `profileId`)
//   - userId: string (required, <= 128 chars, matches parent `userId`)
//   - currentSurah: number (optional, 1..114)
//   - currentAyah: number (optional, 1..286)
//   - totalAyahsMemorized: number (optional, 0..6236)
//   - overallRetentionRate: number (optional, 0..100)
//   - updatedAt: string (optional, ISO timestamp <= 64 chars)
//
// Subcollection: /users/{userId}/recitations/{recitationId}
// Document ID: Unique Recitation Session ID (`recitationId`, string <= 128 chars)
// Fields:
//   - sessionId: string (required, <= 128 chars, matches `recitationId`)
//   - userId: string (required, <= 128 chars, matches parent `userId`)
//   - surahNumber: number (required, 1..114)
//   - ayahNumber: number (required, 1..286)
//   - mode: string (required, enum: 'OPEN_MUSHAF', 'BLIND_TEST')
//   - accuracyScore: number (optional, 0..100)
//   - tajweedScore: number (optional, 0..100)
//   - fluencyScore: number (optional, 0..100)
//   - hesitationCount: number (optional, >= 0)
//   - errorCount: number (optional, >= 0)
//   - timestamp: string (optional, ISO timestamp <= 64 chars)
//
// Collection: /certificates/{certificateId}
// Document ID: Unique Certificate ID (`certificateId`, string <= 128 chars)
// Fields:
//   - certificateId: string (required, <= 128 chars, matches `certificateId`)
//   - userId: string (required, <= 128 chars, student UID)
//   - studentName: string (required, <= 100 chars)
//   - surahNumber: number (required, 1..114)
//   - surahName: string (optional, <= 100 chars)
//   - accuracyScore: number (optional, 0..100)
//   - verificationHash: string (required, <= 128 chars)
//   - issuedAt: string (optional, ISO timestamp <= 64 chars)
//
// Collection: /test/{docId}
// Document ID: 'connection'
// Description: Smoke test connection endpoint for runtime verification.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Authentication & Authorization Helpers
    // ===============================================================

    // Check if the user is authenticated with Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Strict ownership verification: user must be authenticated and UID must match
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin privilege check: requires verified email or admin custom claim
    function isAdmin() {
      return isSignedIn() &&
        (('admin' in request.auth.token && request.auth.token.admin == true) ||
         ('email' in request.auth.token && request.auth.token.email == 'ahmed.sheta89@gmail.com' &&
          'email_verified' in request.auth.token && request.auth.token.email_verified == true));
    }

    // Validate identifier strings (non-empty, bounded length)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Shorthand for incoming request data
    function incoming() {
      return request.resource.data;
    }

    // Shorthand for existing document data
    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Domain Schema Validation Blueprints
    // ===============================================================

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('role' in data) || (data.role is string && data.role in ['ADMIN', 'TEACHER', 'STUDENT'])) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint for StudentProfile
    function isValidStudentProfile(data, userId) {
      return data.keys().hasAll(['studentId', 'userId']) &&
        data.keys().hasOnly(['studentId', 'userId', 'currentSurah', 'currentAyah', 'totalAyahsMemorized', 'overallRetentionRate', 'updatedAt']) &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        (!('currentSurah' in data) || (data.currentSurah is number && data.currentSurah >= 1 && data.currentSurah <= 114)) &&
        (!('currentAyah' in data) || (data.currentAyah is number && data.currentAyah >= 1 && data.currentAyah <= 286)) &&
        (!('totalAyahsMemorized' in data) || (data.totalAyahsMemorized is number && data.totalAyahsMemorized >= 0 && data.totalAyahsMemorized <= 6236)) &&
        (!('overallRetentionRate' in data) || (data.overallRetentionRate is number && data.overallRetentionRate >= 0 && data.overallRetentionRate <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint for RecitationSession
    function isValidRecitationSession(data, userId) {
      return data.keys().hasAll(['sessionId', 'userId', 'surahNumber', 'ayahNumber', 'mode']) &&
        data.keys().hasOnly(['sessionId', 'userId', 'surahNumber', 'ayahNumber', 'mode', 'accuracyScore', 'tajweedScore', 'fluencyScore', 'hesitationCount', 'errorCount', 'timestamp']) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.surahNumber is number && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.ayahNumber is number && data.ayahNumber >= 1 && data.ayahNumber <= 286 &&
        data.mode in ['OPEN_MUSHAF', 'BLIND_TEST'] &&
        (!('accuracyScore' in data) || (data.accuracyScore is number && data.accuracyScore >= 0 && data.accuracyScore <= 100)) &&
        (!('tajweedScore' in data) || (data.tajweedScore is number && data.tajweedScore >= 0 && data.tajweedScore <= 100)) &&
        (!('fluencyScore' in data) || (data.fluencyScore is number && data.fluencyScore >= 0 && data.fluencyScore <= 100)) &&
        (!('hesitationCount' in data) || (data.hesitationCount is number && data.hesitationCount >= 0)) &&
        (!('errorCount' in data) || (data.errorCount is number && data.errorCount >= 0)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64));
    }

    // Validation Blueprint for MasteryCertificate
    function isValidMasteryCertificate(data) {
      return data.keys().hasAll(['certificateId', 'userId', 'studentName', 'surahNumber', 'verificationHash']) &&
        data.keys().hasOnly(['certificateId', 'userId', 'studentName', 'surahNumber', 'surahName', 'accuracyScore', 'verificationHash', 'issuedAt']) &&
        data.certificateId is string && data.certificateId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.studentName is string && data.studentName.size() <= 100 &&
        data.surahNumber is number && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.verificationHash is string && data.verificationHash.size() <= 128 &&
        (!('surahName' in data) || (data.surahName is string && data.surahName.size() <= 100)) &&
        (!('accuracyScore' in data) || (data.accuracyScore is number && data.accuracyScore >= 0 && data.accuracyScore <= 100)) &&
        (!('issuedAt' in data) || (data.issuedAt is string && data.issuedAt.size() <= 64));
    }

    // Validation Blueprint for Public Verification Certificate (Strictly forbids userId!)
    function isValidPublicCertificate(data) {
      return data.keys().hasAll(['certificateId', 'studentName', 'surahNumber', 'verificationHash']) &&
        data.keys().hasOnly(['certificateId', 'studentName', 'surahNumber', 'surahName', 'accuracyScore', 'verificationHash', 'issuedAt']) &&
        !('userId' in data) &&
        data.certificateId is string && data.certificateId.size() <= 128 &&
        data.studentName is string && data.studentName.size() <= 100 &&
        data.surahNumber is number && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.verificationHash is string && data.verificationHash.size() <= 128 &&
        (!('surahName' in data) || (data.surahName is string && data.surahName.size() <= 100)) &&
        (!('accuracyScore' in data) || (data.accuracyScore is number && data.accuracyScore >= 0 && data.accuracyScore <= 100)) &&
        (!('issuedAt' in data) || (data.issuedAt is string && data.issuedAt.size() <= 64));
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Match rules for Users collection and subcollections
    match /users/{userId} {
      // Individual document retrieval: restricted strictly to the owning user or admin
      allow get: if isOwner(userId) || isAdmin();

      // Collection query listing: restricted to super admin only
      allow list: if isAdmin();

      // User profile creation: must be the authenticated owner (or admin), valid schema,
      // UID integrity matching docId, and privilege escalation prevention (non-admin cannot set ADMIN role)
      allow create: if (isOwner(userId) || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == userId &&
                       ((!('role' in incoming()) || incoming().role != 'ADMIN') || isAdmin());

      // User profile update: must be owner/admin, valid schema, immutable UID,
      // and cannot escalate or alter role unless admin
      allow update: if (isOwner(userId) || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == userId &&
                       incoming().uid == existing().uid &&
                       ((!('role' in incoming()) ||
                         (incoming().role != 'ADMIN' && (!('role' in existing()) || incoming().role == existing().role))) || isAdmin());

      // User account deletion: restricted to owner or admin
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollection: Student Memorization Profiles
      match /profiles/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if (isOwner(userId) || isAdmin()) &&
                         isValidId(profileId) &&
                         isValidStudentProfile(incoming(), userId) &&
                         incoming().studentId == profileId;

        allow update: if (isOwner(userId) || isAdmin()) &&
                         isValidId(profileId) &&
                         isValidStudentProfile(incoming(), userId) &&
                         incoming().studentId == profileId &&
                         incoming().studentId == existing().studentId &&
                         incoming().userId == existing().userId;

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Recitation Sessions
      match /recitations/{recitationId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if (isOwner(userId) || isAdmin()) &&
                         isValidId(recitationId) &&
                         isValidRecitationSession(incoming(), userId) &&
                         incoming().sessionId == recitationId;

        allow update: if (isOwner(userId) || isAdmin()) &&
                         isValidId(recitationId) &&
                         isValidRecitationSession(incoming(), userId) &&
                         incoming().sessionId == recitationId &&
                         incoming().sessionId == existing().sessionId &&
                         incoming().userId == existing().userId;

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Subcollection: User's Private Certificates (Owner and Admin only)
      match /certificates/{certificateId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if (isOwner(userId) || isAdmin()) &&
                         isValidId(certificateId) &&
                         isValidMasteryCertificate(incoming()) &&
                         incoming().certificateId == certificateId &&
                         incoming().userId == userId;

        allow update: if false;

        allow delete: if isAdmin();
      }
    }

    // Two-Tier Public Verification Certificates (Public single-get, Strictly NO userId)
    match /public_certificates/{certificateId} {
      // Public single-get for QR-code and shared link verification
      allow get: if true;

      // Bulk listing strictly forbidden to prevent scraping/enumeration
      allow list: if false;

      // Creation by authenticated user or admin matching schema (strictly without userId)
      allow create: if isSignedIn() &&
                       isValidId(certificateId) &&
                       isValidPublicCertificate(incoming()) &&
                       incoming().certificateId == certificateId;

      // Certificates are immutable
      allow update: if false;

      // Revocation/deletion restricted to super admin
      allow delete: if isAdmin();
    }

    // Legacy Certificate Collection (Deprecating public get - restricted to owner or admin)
    match /certificates/{certificateId} {
      // Private get/list: authenticated owner or admin only (eliminates public exposure of userId)
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Certificate generation: authenticated user creating their own certificate or admin, strictly validated
      allow create: if isSignedIn() &&
                       (incoming().userId == request.auth.uid || isAdmin()) &&
                       isValidId(certificateId) &&
                       isValidMasteryCertificate(incoming()) &&
                       incoming().certificateId == certificateId;

      // Certificates are cryptographically signed and immutable once issued
      allow update: if false;

      // Revocation/deletion: strictly restricted to super admin
      allow delete: if isAdmin();
    }

    // Test connection document for app initialization check
    match /test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
